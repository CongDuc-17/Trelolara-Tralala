# Copy to .env.e2e-live.local. Use verified accounts on an isolated test backend.
# Never put passwords in VITE_* variables. This file contains no credentials.
VITE_ENV=e2e-live
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SECOND_EMAIL=
E2E_SECOND_PASSWORD=
